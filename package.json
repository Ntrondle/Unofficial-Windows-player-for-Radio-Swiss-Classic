{
  "name": "radio-swiss-classic-player",
  "version": "1.3.0",
  "description": "Tiny desktop player for Radio Swiss Classic",
  "author": "Nico",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.nico.radio-swiss-classic-player",
    "productName": "Radio Swiss Classic Player",
    "copyright": "Copyright (c) Nico — streams and metadata by SRG SSR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/icon.png",
      "assets/logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "RadioSwissClassicPlayer-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "artifactName": "RadioSwissClassicPlayer-${version}-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 360
      }
    }
  }
}
